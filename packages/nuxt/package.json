{
  "name": "@liftkit-vue/nuxt",
  "version": "0.2.4",
  "description": "Nuxt 4 module for LiftKit Vue - auto-imports components and CSS design tokens",
  "type": "module",
  "license": "MIT",
  "author": "annrie",
  "repository": {
    "type": "git",
    "url": "https://github.com/annrie/liftkit-vue",
    "directory": "packages/nuxt"
  },
  "homepage": "https://github.com/annrie/liftkit-vue/tree/main/packages/nuxt",
  "bugs": "https://github.com/annrie/liftkit-vue/issues",
  "keywords": [
    "nuxt",
    "nuxt4",
    "nuxt-module",
    "vue",
    "material-design",
    "md3",
    "design-system",
    "liftkit"
  ],
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "import": "./dist/module.mjs",
      "types": "./dist/types.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@liftkit-vue/core": "^0.2.4",
    "@nuxt/kit": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.5.0",
    "nuxt": "^4.5.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  }
}
